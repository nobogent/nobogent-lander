    <!-- Interactive Scripts for Calculator, Table Filter, FAQ Accordion, VSL Video, and Qualification Modal -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        // --- 1. Interactive ROI / Savings Calculator ---
        var agencySpendSlider = document.getElementById('agencySpendSlider');
        var agencySpendDisplay = document.getElementById('agencySpendDisplay');
        var leadsSlider = document.getElementById('leadsSlider');
        var leadsDisplay = document.getElementById('leadsDisplay');
        var monthlySavingsVal = document.getElementById('monthlySavingsVal');
        var annualSavingsVal = document.getElementById('annualSavingsVal');
        var hoursSavedVal = document.getElementById('hoursSavedVal');

        var NOBOGENT_MONTHLY_COST = 9999;

        function updateCalculator() {
          if (!agencySpendSlider || !leadsSlider) return;
          var agencySpend = parseInt(agencySpendSlider.value, 10);
          var leads = parseInt(leadsSlider.value, 10);

          agencySpendDisplay.textContent = '₹' + agencySpend.toLocaleString('en-IN');
          leadsDisplay.textContent = leads.toLocaleString('en-IN') + ' Leads';

          var monthlySavings = Math.max(0, agencySpend - NOBOGENT_MONTHLY_COST);
          var annualSavings = (agencySpend * 12) - (99999); // using 1-year annual plan
          var hoursSaved = Math.round(leads * 0.5); // ~30 mins per lead saved in manual follow-ups

          monthlySavingsVal.textContent = '₹' + monthlySavings.toLocaleString('en-IN');
          annualSavingsVal.textContent = '₹' + annualSavings.toLocaleString('en-IN') + ' / yr';
          hoursSavedVal.textContent = hoursSaved;
        }

        if (agencySpendSlider && leadsSlider) {
          agencySpendSlider.addEventListener('input', updateCalculator);
          leadsSlider.addEventListener('input', updateCalculator);
          updateCalculator();
        }

        // --- 2. Interactive Feature Filter Tabs ---
        var filterTabs = document.querySelectorAll('.filter-tab');
        var tableRows = document.querySelectorAll('#tableBody tr[data-category]');

        filterTabs.forEach(function(tab) {
          tab.addEventListener('click', function() {
            filterTabs.forEach(function(t) { t.classList.remove('active'); });
            tab.classList.add('active');

            var category = tab.getAttribute('data-category');

            tableRows.forEach(function(row) {
              if (category === 'all' || row.getAttribute('data-category') === category) {
                row.style.display = '';
              } else {
                row.style.display = 'none';
              }
            });
          });
        });

        // --- 3. FAQ Accordion ---
        var faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(function(item) {
          var header = item.querySelector('.faq-header');
          if (header) {
            header.addEventListener('click', function() {
              var isOpen = item.classList.contains('open');
              faqItems.forEach(function(i) { i.classList.remove('open'); });
              if (!isOpen) {
                item.classList.add('open');
              }
            });
          }
        });

        // --- 4. Mobile Menu Drawer Toggle ---
        var mobileMenuToggle = document.getElementById('mobileMenuToggle');
        var mobileNavDrawer = document.getElementById('mobileNavDrawer');
        var hamburgerIcon = mobileMenuToggle ? mobileMenuToggle.querySelector('.hamburger-icon') : null;
        var closeIcon = mobileMenuToggle ? mobileMenuToggle.querySelector('.close-icon') : null;

        if (mobileMenuToggle && mobileNavDrawer) {
          mobileMenuToggle.addEventListener('click', function() {
            var isOpen = mobileNavDrawer.classList.contains('open');
            if (isOpen) {
              mobileNavDrawer.classList.remove('open');
              mobileMenuToggle.setAttribute('aria-expanded', 'false');
              if (hamburgerIcon) hamburgerIcon.style.display = 'block';
              if (closeIcon) closeIcon.style.display = 'none';
            } else {
              mobileNavDrawer.classList.add('open');
              mobileMenuToggle.setAttribute('aria-expanded', 'true');
              if (hamburgerIcon) hamburgerIcon.style.display = 'none';
              if (closeIcon) closeIcon.style.display = 'block';
            }
          });

          // Close mobile drawer on item tap
          var mobileNavItems = mobileNavDrawer.querySelectorAll('a');
          mobileNavItems.forEach(function(item) {
            item.addEventListener('click', function() {
              mobileNavDrawer.classList.remove('open');
              mobileMenuToggle.setAttribute('aria-expanded', 'false');
              if (hamburgerIcon) hamburgerIcon.style.display = 'block';
              if (closeIcon) closeIcon.style.display = 'none';
            });
          });
        }

        // =========================================================================
        // 5. VSL Video Player Handler (Fast Streaming & Clean Play Overlay)
        // =========================================================================
        var vslVideoPlayer = document.getElementById('vslVideoPlayer');
        var vslPlayOverlay = document.getElementById('vslPlayOverlay');

        if (vslVideoPlayer && vslPlayOverlay) {
          vslPlayOverlay.addEventListener('click', function() {
            vslPlayOverlay.classList.add('hidden');
            vslVideoPlayer.play().catch(function(err) {
              console.warn('[VSL] Auto-play prevented:', err);
            });
          });

          vslVideoPlayer.addEventListener('pause', function() {
            if (vslVideoPlayer.currentTime < 1 || vslVideoPlayer.ended) {
              vslPlayOverlay.classList.remove('hidden');
            }
          });

          vslVideoPlayer.addEventListener('play', function() {
            vslPlayOverlay.classList.add('hidden');
          });
        }

        // =========================================================================
        // 6. Qualification Modal & Lead CRM Submission Engine
        // =========================================================================
        var qualModalBackdrop = document.getElementById('qualModalBackdrop');
        var qualModalCloseBtn = document.getElementById('qualModalCloseBtn');
        var qualPrevBtn = document.getElementById('qualPrevBtn');
        var qualNextBtn = document.getElementById('qualNextBtn');
        var qualNextBtnText = document.getElementById('qualNextBtnText');
        var qualModalFooter = document.getElementById('qualModalFooter');
        var qualProgressFill = document.getElementById('qualProgressFill');
        var qualStepIndicator = document.getElementById('qualStepIndicator');
        var qualPercentIndicator = document.getElementById('qualPercentIndicator');
        var selectedPlanInput = document.getElementById('selectedPlanInput');
        var trafficSourceInput = document.getElementById('trafficSourceInput');
        var employeeAlert = document.getElementById('employeeAlert');
        var otherCrmInputWrapper = document.getElementById('otherCrmInputWrapper');
        var otherCrmInput = document.getElementById('otherCrmInput');

        var currentStep = 1;
        var totalSteps = 4;

        var stepTitles = {
          1: 'Step 1 of 4: Business Profile & Marketing Spend',
          2: 'Step 2 of 4: Lead Volume & Decision Maker',
          3: 'Step 3 of 4: Primary Goals & Current CRM',
          4: 'Step 4 of 4: Contact & Priority Onboarding Access'
        };

        var stepPercents = {
          1: '25%',
          2: '50%',
          3: '75%',
          4: '95%'
        };

        // Form answers state
        var leadAnswers = {
          business_type: '',
          marketing_spend: '',
          leads_per_month: '',
          responsible_role: '',
          primary_goals: ['Generate more leads', 'Respond to leads faster'],
          current_crm: '',
          name: '',
          phone: '',
          email: '',
          city: ''
        };

        function openModal(planName, source) {
          if (planName) selectedPlanInput.value = planName;
          if (source) trafficSourceInput.value = source;
          qualModalBackdrop.classList.add('open');
          qualModalBackdrop.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          qualModalBackdrop.classList.remove('open');
          qualModalBackdrop.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (qualModalCloseBtn) {
          qualModalCloseBtn.addEventListener('click', closeModal);
        }

        qualModalBackdrop.addEventListener('click', function(e) {
          if (e.target === qualModalBackdrop) {
            closeModal();
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && qualModalBackdrop.classList.contains('open')) {
            closeModal();
          }
        });

        // Option chips selection listener
        var optionChips = document.querySelectorAll('.qual-option-chip');
        optionChips.forEach(function(chip) {
          chip.addEventListener('click', function() {
            var group = chip.closest('.qual-options-grid');
            if (!group) return;
            var groupName = group.getAttribute('data-group');
            var isMulti = group.getAttribute('data-multi') === 'true';
            var val = chip.getAttribute('data-val');

            if (isMulti) {
              chip.classList.toggle('selected');
              var selectedMulti = [];
              group.querySelectorAll('.qual-option-chip.selected').forEach(function(s) {
                selectedMulti.push(s.getAttribute('data-val'));
              });
              leadAnswers[groupName] = selectedMulti;
            } else {
              group.querySelectorAll('.qual-option-chip').forEach(function(c) {
                c.classList.remove('selected');
              });
              chip.classList.add('selected');
              leadAnswers[groupName] = val;

              // Employee/Executive prompt handling
              if (groupName === 'responsible_role') {
                if (val === 'Employee/Executive') {
                  employeeAlert.classList.add('show');
                } else {
                  employeeAlert.classList.remove('show');
                }
              }

              // Other CRM input visibility
              if (groupName === 'current_crm') {
                if (val === 'Other CRM') {
                  otherCrmInputWrapper.style.display = 'block';
                  otherCrmInput.focus();
                } else {
                  otherCrmInputWrapper.style.display = 'none';
                }
              }
            }

            // Hide active step error if any
            var activeErr = document.querySelector('.qual-step.active .qual-error-msg');
            if (activeErr) activeErr.classList.remove('show');
          });
        });

        function renderStep(step) {
          document.querySelectorAll('.qual-step').forEach(function(s) {
            s.classList.remove('active');
          });
          var targetStep = document.querySelector('.qual-step[data-step="' + step + '"]');
          if (targetStep) targetStep.classList.add('active');

          if (step <= totalSteps) {
            qualProgressFill.style.width = stepPercents[step];
            qualStepIndicator.textContent = stepTitles[step];
            qualPercentIndicator.textContent = stepPercents[step] + ' Complete';
            qualPrevBtn.style.display = step > 1 ? 'inline-block' : 'none';
            qualNextBtnText.textContent = step === 4 ? 'Submit Application & Get Instant Access →' : 'Continue →';
            qualModalFooter.style.display = 'flex';
          } else {
            // Success Step 5
            qualProgressFill.style.width = '100%';
            qualStepIndicator.textContent = 'Qualification Complete';
            qualPercentIndicator.textContent = '100% Done';
            qualModalFooter.style.display = 'none';
          }
        }

        // Validate Step
        function validateStep(step) {
          if (step === 1) {
            var s1Err = document.getElementById('step1Error');
            if (!leadAnswers.business_type || !leadAnswers.marketing_spend) {
              s1Err.classList.add('show');
              return false;
            }
            s1Err.classList.remove('show');
            return true;
          }
          if (step === 2) {
            var s2Err = document.getElementById('step2Error');
            if (!leadAnswers.leads_per_month || !leadAnswers.responsible_role) {
              s2Err.classList.add('show');
              return false;
            }
            s2Err.classList.remove('show');
            return true;
          }
          if (step === 3) {
            var s3Err = document.getElementById('step3Error');
            if (!leadAnswers.primary_goals || leadAnswers.primary_goals.length === 0 || !leadAnswers.current_crm) {
              s3Err.classList.add('show');
              return false;
            }
            if (leadAnswers.current_crm === 'Other CRM' && otherCrmInput.value.trim()) {
              leadAnswers.current_crm = 'Other: ' + otherCrmInput.value.trim();
            }
            s3Err.classList.remove('show');
            return true;
          }
          if (step === 4) {
            var s4Err = document.getElementById('step4Error');
            var nameInput = document.getElementById('qualName');
            var phoneInput = document.getElementById('qualPhone');
            var emailInput = document.getElementById('qualEmail');
            var cityInput = document.getElementById('qualCity');

            var nameVal = nameInput.value.trim();
            var phoneVal = phoneInput.value.trim().replace(/\D/g, '');
            var emailVal = emailInput.value.trim();
            var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            var isValid = true;
            if (nameVal.length < 2) {
              nameInput.classList.add('error');
              isValid = false;
            } else {
              nameInput.classList.remove('error');
            }

            if (phoneVal.length < 10) {
              phoneInput.classList.add('error');
              isValid = false;
            } else {
              phoneInput.classList.remove('error');
            }

            if (!emailRegex.test(emailVal)) {
              emailInput.classList.add('error');
              isValid = false;
            } else {
              emailInput.classList.remove('error');
            }

            if (!isValid) {
              s4Err.classList.add('show');
              return false;
            }

            s4Err.classList.remove('show');
            leadAnswers.name = nameVal;
            leadAnswers.phone = phoneInput.value.trim();
            leadAnswers.email = emailVal;
            leadAnswers.city = cityInput ? cityInput.value.trim() : '';
            return true;
          }
          return true;
        }

        // Step Navigation Buttons
        qualNextBtn.addEventListener('click', function() {
          if (!validateStep(currentStep)) return;

          if (currentStep < 4) {
            currentStep++;
            renderStep(currentStep);
          } else if (currentStep === 4) {
            // Submit form to Nobogent CRM (rchopra489@gmail.com)
            submitLeadForm();
          }
        });

        qualPrevBtn.addEventListener('click', function() {
          if (currentStep > 1) {
            currentStep--;
            renderStep(currentStep);
          }
        });

        // Submit to Nobogent Super Admin CRM + Fire Meta Pixel Event
        function submitLeadForm() {
          qualNextBtn.disabled = true;
          qualNextBtnText.textContent = 'Submitting Application...';

          var payload = {
            name: leadAnswers.name,
            phone: leadAnswers.phone,
            email: leadAnswers.email,
            business_type: leadAnswers.business_type,
            marketing_spend: leadAnswers.marketing_spend,
            leads_per_month: leadAnswers.leads_per_month,
            responsible_role: leadAnswers.responsible_role,
            primary_goals: leadAnswers.primary_goals,
            current_crm: leadAnswers.current_crm,
            city: leadAnswers.city,
            plan: selectedPlanInput.value,
            source: trafficSourceInput.value,
            ad_account_id: '1532845147843203',
            pixel_id: '1684055349552829'
          };

          // Primary endpoint: Same-origin Vercel serverless function /api/qualification-lead
          // Fallback endpoint: https://app.nobogent.com/api/contact
          fetch('/api/qualification-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(function(res) {
            if (!res.ok) {
              // Try fallback to app.nobogent.com contact API
              return fetch('https://app.nobogent.com/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: payload.name,
                  email: payload.email,
                  phone: payload.phone,
                  budget: payload.marketing_spend,
                  timeline: payload.leads_per_month,
                  message: [
                    '=== PRICING INDIA QUALIFICATION FORM ===',
                    'Business: ' + payload.business_type,
                    'Marketing Spend: ' + payload.marketing_spend,
                    'Leads/Mo: ' + payload.leads_per_month,
                    'Responsible Lead: ' + payload.responsible_role,
                    'Goals: ' + (payload.primary_goals.join(', ')),
                    'CRM: ' + payload.current_crm,
                    'City: ' + payload.city,
                    'Target Admin: rchopra489@gmail.com'
                  ].join('\n')
                })
              });
            }
            return res.json();
          })
          .catch(function(err) {
            console.warn('[CRM Lead Dispatch] Attempting fallback submission:', err);
          })
          .finally(function() {
            // Track Meta Pixel Lead event
            try {
              if (typeof window.fbq === 'function') {
                window.fbq('track', 'Lead', {
                  content_name: 'Pricing India Qualification Form',
                  content_category: 'Real Estate AI Department',
                  value: 9999.00,
                  currency: 'INR'
                });
                console.log('[Meta Pixel] Lead event tracked successfully (Pixel: 1684055349552829)');
              }
            } catch (pixelErr) {
              console.warn('[Meta Pixel] Tracking notice:', pixelErr);
            }

            // Update success screen details
            var nameEl = document.getElementById('successLeadName');
            var phoneEl = document.getElementById('successLeadPhone');
            if (nameEl) nameEl.textContent = leadAnswers.name || 'Partner';
            if (phoneEl) phoneEl.textContent = leadAnswers.phone || 'your WhatsApp';

            currentStep = 5;
            renderStep(5);
          });
        }

        // =========================================================================
        // 7. Universal Button Interception: Connect EVERY button to Qualification Popup
        // =========================================================================
        function bindAllButtonsToModal() {
          // Explicit open modal buttons
          document.querySelectorAll('.open-qual-modal').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              var plan = btn.getAttribute('data-plan') || 'Growth Plan (₹9,999/mo)';
              var source = btn.getAttribute('data-source') || 'cta_button';
              openModal(plan, source);
            });
          });

          // Any CTA links on the page targeting #plans or external nobogent
          document.querySelectorAll('a[href="#plans"], a[href^="https://nobogent.com"]').forEach(function(anchor) {
            anchor.addEventListener('click', function(e) {
              e.preventDefault();
              var plan = anchor.getAttribute('data-plan') || 'Growth Plan (₹9,999/mo)';
              var source = anchor.getAttribute('data-source') || anchor.textContent.trim();
              openModal(plan, source);
            });
          });
        }

        bindAllButtonsToModal();
      });
    </script>
  </body>
</html>
