        }

        .calc-card {
          padding: 20px 16px;
          border-radius: var(--rounded-lg);
        }
        .calc-result-box {
          padding: 22px 16px;
        }
        #monthlySavingsVal {
          font-size: clamp(30px, 8vw, 38px) !important;
        }
        #annualSavingsVal {
          font-size: clamp(20px, 5.5vw, 24px) !important;
        }
        .slider-ticks span {
          font-size: 10px;
        }

        .plan-card {
          padding: 22px 16px;
        }
        .plan-price-num {
          font-size: 32px;
        }

        .guarantee-box {
          flex-direction: column !important;
          text-align: center !important;
          padding: 24px 16px !important;
          gap: 14px !important;
        }

        .faq-header {
          padding: 16px 16px;
        }
        .faq-title {
          font-size: 14px;
        }
        .faq-body {
          padding: 0 16px 16px;
          font-size: 13px;
        }

        .final-cta-btn-group {
          flex-direction: column;
          width: 100%;
          max-width: 320px;
          margin: 0 auto;
          gap: 10px !important;
        }
        .final-cta-btn-group .btn {
          width: 100%;
          padding: 12px 20px !important;
        }

        .footer-bottom-bar {
          flex-direction: column;
          gap: 8px !important;
        }
      }

      /* Extra Small Mobile Devices (<= 480px) */
      @media (max-width: 480px) {
        .header-logo-img {
          height: 36px;
          max-width: 110px;
        }
        .header-btn-login {
          display: none !important;
        }
        .header-btn-plans {
          padding: 6px 12px !important;
          font-size: 12px !important;
        }
        .badge-pill {
          font-size: 10px;
          padding: 5px 10px;
        }
        .tick-sub {
          display: none;
        }
      }

      /* =========================================================================
         VSL Video Showcase Section (High-Performance, Vercel-Styled)
         ========================================================================= */
      .vsl-showcase-container {
        max-width: 960px;
        width: 100%;
        margin: var(--spacing-xl) auto var(--spacing-3xl);
        text-align: left;
      }

      .vsl-frame {
        background: #090a0f;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
      }

      .vsl-frame:hover {
        border-color: rgba(255, 255, 255, 0.22);
        box-shadow: 0 30px 70px -10px rgba(0, 112, 243, 0.15), 0 0 0 1px rgba(255, 255, 255, 0.08);
      }

      .vsl-screen-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        background: #111218;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .vsl-dots-group {
        display: flex;
        gap: 7px;
        align-items: center;
      }

      .vsl-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        display: inline-block;
      }

      .vsl-dot-red { background: #ff5f56; }
      .vsl-dot-yellow { background: #ffbd2e; }
      .vsl-dot-green { background: #27c93f; }

      .vsl-topbar-title {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: #a1a1aa;
        letter-spacing: 0.02em;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0 12px;
      }

      .vsl-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Geist Mono', monospace;
        font-size: 10px;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
        padding: 2px 8px;
        border-radius: 999px;
      }

      .vsl-dot-live {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 6px #38bdf8;
      }

      .vsl-video-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #000;
        overflow: hidden;
      }

      .vsl-video-element {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain;
        background: #000;
      }

      .vsl-play-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        cursor: pointer;
        transition: opacity 0.25s ease, visibility 0.25s ease;
        z-index: 5;
      }

      .vsl-play-overlay.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .vsl-custom-play-btn {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0070f3, #0051b3);
        border: 2px solid rgba(255, 255, 255, 0.4);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 30px rgba(0, 112, 243, 0.6), 0 4px 14px rgba(0,0,0,0.5);
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
        padding-left: 4px;
      }

      .vsl-play-overlay:hover .vsl-custom-play-btn {
        transform: scale(1.1);
        box-shadow: 0 0 40px rgba(0, 112, 243, 0.8), 0 6px 20px rgba(0,0,0,0.6);
      }

      .vsl-play-text {
        text-align: center;
        color: #ffffff;
      }

      .vsl-play-text strong {
        display: block;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 4px;
      }

      .vsl-play-text span {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.75);
      }

      .vsl-bottom-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 24px;
        background: #111218;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
      }

      .vsl-bottom-text {
        color: #ffffff;
        text-align: left;
      }

      .vsl-bottom-text strong {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 2px;
      }

      .vsl-bottom-text span {
        font-size: 12px;
        color: #a1a1aa;
      }

      /* =========================================================================
         Qualification Modal (Vercel-Inspired, High-Converting 4-Step Architecture)
         ========================================================================= */
      /* =========================================================================
         Qualification Modal (Vercel-Inspired, Clean Light Theme Architecture)
         ========================================================================= */
      .qual-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 100000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .qual-modal-backdrop.open {
        opacity: 1;
        visibility: visible;
      }

      .qual-modal-container {
        width: 100%;
        max-width: 620px;
        max-height: 92vh;
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 18px;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.04);
        color: #1f2937;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transform: scale(0.96) translateY(8px);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .qual-modal-backdrop.open .qual-modal-container {
        transform: scale(1) translateY(0);
      }

      .qual-modal-header {
        padding: 18px 24px 14px;
        border-bottom: 1px solid #f3f4f6;
        background: #ffffff;
      }

      .qual-modal-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }

      .qual-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #0070f3;
        background: rgba(0, 112, 243, 0.08);
        border: 1px solid rgba(0, 112, 243, 0.2);
        padding: 3px 10px;
        border-radius: 999px;
      }

      .qual-modal-close {
        background: transparent;
        border: none;
        color: #6b7280;
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
      }

      .qual-modal-close:hover {
        background: #f3f4f6;
        color: #111827;
      }

      .qual-progress-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: #6b7280;
        margin-bottom: 6px;
        font-weight: 500;
      }

      .qual-progress-track {
        width: 100%;
        height: 5px;
        background: #f3f4f6;
        border-radius: 999px;
        overflow: hidden;
      }

      .qual-progress-fill {
        height: 100%;
        width: 25%;
        background: linear-gradient(90deg, #0070f3, #0284c7);
        border-radius: 999px;
        transition: width 0.3s ease;
      }

      .qual-modal-body {
        padding: 24px;
        background: #ffffff;
        overflow-y: auto;
        flex: 1;
        -webkit-overflow-scrolling: touch;
      }

      .qual-step {
        display: none;
      }

      .qual-step.active {
        display: block;
        animation: qualFadeIn 0.2s ease forwards;
      }

      @keyframes qualFadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .qual-group {
        margin-bottom: 22px;
      }

      .qual-group:last-child {
        margin-bottom: 0;
      }

      .qual-q-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 6px;
      }

      .qual-q-title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.01em;
      }

      .qual-q-tag {
        font-family: 'Geist Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 4px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .tag-qualifier {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
      }

      .tag-important {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
      }

      .tag-optional {
        background: #f3f4f6;
        color: #4b5563;
        border: 1px solid #e5e7eb;
      }

      .qual-options-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 8px;
      }

      .qual-options-grid.list-view {
        grid-template-columns: 1fr;
      }

      .qual-option-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 10px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      }

      .qual-option-chip:hover {
        background: #f9fafb;
        border-color: #cbd5e1;
      }

      .qual-option-chip.selected {
        background: #eff6ff;
        border-color: #0070f3;
        box-shadow: 0 0 0 1px #0070f3, 0 1px 3px rgba(0, 112, 243, 0.1);
      }

      .qual-option-indicator {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 1.5px solid #d1d5db;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.15s ease;
      }

      .qual-option-chip.selected .qual-option-indicator {
        border-color: #0070f3;
        background: #0070f3;
      }

      .qual-option-chip.selected .qual-option-indicator::after {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #ffffff;
      }

      /* Multi-select check square */
      .qual-option-chip.multi .qual-option-indicator {
        border-radius: 4px;
      }

      .qual-option-chip.multi.selected .qual-option-indicator::after {
        content: '✓';
        font-size: 10px;
        color: #ffffff;
        background: transparent;
        font-weight: 800;
      }

      .qual-option-text {
        font-size: 13px;
        color: #374151;
        font-weight: 500;
        line-height: 1.3;
      }

      .qual-option-chip.selected .qual-option-text {
        color: #0f172a;
        font-weight: 600;
      }

      .qual-emp-alert {
        display: none;
        margin-top: 10px;
        padding: 10px 14px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        font-size: 12px;
        color: #b45309;
        line-height: 1.5;
      }

      .qual-emp-alert.show {
        display: block;
        animation: qualFadeIn 0.2s ease;
      }

      .qual-field {
        margin-bottom: 14px;
      }

      .qual-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 6px;
        text-transform: uppercase;
        font-family: 'Geist Mono', monospace;
        letter-spacing: 0.04em;
      }

      .qual-input {
        width: 100%;
        padding: 11px 14px;
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        color: #111827;
        transition: all 0.15s ease;
        outline: none;
        font-family: 'Inter', sans-serif;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }

      .qual-input::placeholder {
        color: #9ca3af;
      }

      .qual-input:focus {
        border-color: #0070f3;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(0, 112, 243, 0.15);
      }

      .qual-input.error {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
      }

      .qual-modal-footer {
        padding: 16px 24px;
        background: #f9fafb;
        border-top: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .btn-qual-back {
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #4b5563;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      }

      .btn-qual-back:hover {
        background: #f3f4f6;
        color: #111827;
        border-color: #9ca3af;
      }

      .btn-qual-next {
        background: #0070f3;
        border: 1px solid #0070f3;
        color: #ffffff;
        padding: 11px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.15s ease;
        box-shadow: 0 2px 10px rgba(0, 112, 243, 0.25);
      }

      .btn-qual-next:hover {
        background: #0060df;
        box-shadow: 0 4px 16px rgba(0, 112, 243, 0.4);
      }

      .btn-qual-next:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .qual-error-msg {
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
        font-weight: 500;
        display: none;
      }

      .qual-error-msg.show {
        display: block;
      }

      /* Success Screen */
      .qual-success-box {
        text-align: center;
        padding: 24px 16px;
      }

      .qual-success-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #ecfdf5;
        border: 2px solid #10b981;
        color: #059669;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        box-shadow: 0 0 24px rgba(16, 185, 129, 0.2);
      }

      .qual-success-title {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
      }

      .qual-success-desc {
        font-size: 14px;
        color: #4b5563;
        line-height: 1.6;
        max-width: 440px;
        margin: 0 auto 20px;
      }

      .qual-success-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 999px;
        font-size: 12px;
        color: #0284c7;
        font-family: 'Geist Mono', monospace;
      }

      @media (max-width: 640px) {
        .qual-modal-container {
          max-height: 96vh;
          border-radius: 14px;
        }
        .qual-modal-body {
          padding: 16px 16px;
        }
        .qual-modal-header {
          padding: 14px 16px 10px;
        }
        .qual-modal-footer {
          padding: 12px 16px;
        }
        .qual-options-grid {
          grid-template-columns: 1fr;
        }
        .vsl-bottom-banner {
          flex-direction: column;
          align-items: stretch;
          text-align: center;
        }
        .vsl-bottom-text {
          text-align: center;
        }
      }
    </style>
  </head>
