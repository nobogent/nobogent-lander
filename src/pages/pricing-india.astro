          <a href="https://app.nobogent.com" class="btn btn-secondary header-btn-login" style="padding: var(--spacing-xxs) var(--spacing-md); font-size: 13px;">Login</a>
          <button type="button" class="btn btn-primary header-btn-plans open-qual-modal" data-source="header_cta" style="padding: var(--spacing-xxs) var(--spacing-md); font-size: 13px; cursor: pointer;">Get Started</button>
          <button id="mobileMenuToggle" class="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
            <svg class="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
