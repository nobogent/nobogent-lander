---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoTransparent from '../assets/logo-transparent.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo-transparent.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>Nobogent AI vs Traditional Agencies | Feature & Price Comparison (India)</title>
    <meta name="description" content="Compare Nobogent AI Sales & Marketing Department with traditional Indian real estate digital marketing agencies. See why realtors save ₹60,000+/month with 10x faster lead conversions." />
    <meta name="keywords" content="nobogent pricing, real estate marketing agency cost india, AI calling real estate, real estate CRM pricing, WhatsApp bot real estate price, real estate lead generation cost india" />
    <link rel="canonical" href="https://nobogent.com/pricing-india" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.cdnfonts.com/css/geist-sans" rel="stylesheet" />
    <link href="https://fonts.cdnfonts.com/css/geist-mono" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nobogent.com/pricing-india" />
    <meta property="og:title" content="Nobogent AI vs Indian Digital Marketing Agencies | Pricing & Feature Breakdown" />
    <meta property="og:description" content="Why pay ₹70,000+/mo for slow agency retainers? Get an instant 30s AI calling department, 24/7 WhatsApp AI concierge, and Meta CAPI ads for ₹9,999/mo." />
    <!-- Meta Pixel Code (Ad Account: 1532845147843203, Pixel ID: 1684055349552829) -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1684055349552829');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1684055349552829&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel Code -->

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": "Nobogent AI Real Estate Operating System",
        "image": "https://nobogent.com/logo-transparent.png",
        "description": "AI-powered real estate marketing and sales automation platform replacing disjointed marketing agencies and manual calling desks.",
        "brand": {
          "@type": "Brand",
          "name": "Nobogent"
        },
        "offers": [
          {
            "@type": "Offer",
            "name": "1 Month Growth Plan",
            "price": "9999",
            "priceCurrency": "INR",
            "availability": "https://schema.org/InStock",
            "url": "https://nobogent.com/pricing-india"
          },
          {
            "@type": "Offer",
            "name": "12 Months Annual Plan",
            "price": "99999",
            "priceCurrency": "INR",
            "availability": "https://schema.org/InStock",
            "url": "https://nobogent.com/pricing-india"
          }
        ]
      }
    </script>

    <style>
      /* Custom styles complementing global.css with Vercel aesthetic */
      :global(html), :global(body) {
        overflow-x: hidden;
        max-width: 100vw;
      }

      .pricing-hero {
        padding: var(--spacing-5xl) 0 var(--spacing-3xl);
        text-align: center;
        position: relative;
      }

      .pricing-hero h1 {
        font-size: clamp(2rem, 4.5vw, 4.25rem);
        letter-spacing: -0.04em;
        line-height: 1.1;
      }

      .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: rgba(23, 23, 23, 0.04);
        border: 1px solid rgba(23, 23, 23, 0.1);
        border-radius: var(--rounded-pill);
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-ink);
        margin-bottom: var(--spacing-lg);
        max-width: 100%;
      }

      .badge-pill .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulseGreen 2s infinite;
        flex-shrink: 0;
      }

      @keyframes pulseGreen {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
      }

      /* Header & Mobile Drawer */
      .header-logo-link {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
      }

      .header-logo-img {
        height: 48px;
        width: auto;
        max-width: 170px;
        object-fit: contain;
      }

      .header-cta-group {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .mobile-menu-btn {
        display: none;
        background: transparent;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-md);
        padding: 7px;
        cursor: pointer;
        color: var(--color-ink);
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
      }

      .mobile-menu-btn:hover {
        background: var(--color-canvas-soft);
        border-color: var(--color-hairline-strong);
      }

      .mobile-nav-drawer {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--color-hairline);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        padding: 16px 20px 24px;
        z-index: 999;
      }

      .mobile-nav-drawer.open {
        display: block;
        animation: drawerSlide 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes drawerSlide {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .mobile-nav-links {
        list-style: none;
        padding: 0;
        margin: 0 0 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .mobile-nav-item {
        display: block;
        padding: 11px 14px;
        font-size: 14px;
        font-weight: 500;
        color: var(--color-ink);
        border-radius: var(--rounded-md);
        transition: background 0.15s ease, color 0.15s ease;
      }

      .mobile-nav-item:hover, .mobile-nav-item:active {
        background: var(--color-canvas-soft-2);
        color: var(--color-link);
      }

      .mobile-nav-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-top: 12px;
        border-top: 1px solid var(--color-hairline);
      }

      .stats-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--spacing-md);
        margin: var(--spacing-3xl) auto 0;
        max-width: 1050px;
        background: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-xl);
        padding: var(--spacing-xl);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      }

      .stat-card {
        text-align: left;
        padding: 0 var(--spacing-md);
        border-right: 1px solid var(--color-hairline);
      }

      .stat-card:last-child {
        border-right: none;
      }

      .stat-num {
        font-family: 'Plus Jakarta Sans', var(--font-display, sans-serif);
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
        color: var(--color-ink);
        margin-bottom: 4px;
        word-break: break-word;
      }

      .stat-num.highlight {
        background: linear-gradient(135deg, #0070f3 0%, #7928ca 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .stat-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-ink);
        margin-bottom: 2px;
      }

      .stat-desc {
        font-size: 11px;
        color: var(--color-mute);
        line-height: 1.4;
      }

      /* Disjointed Agency vs Nobogent Visual Split */
      .split-compare-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-xl);
        max-width: 1140px;
        margin: var(--spacing-3xl) auto 0;
        text-align: left;
      }

      .cost-stack-card {
        background: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-xl);
        padding: var(--spacing-2xl);
        position: relative;
        box-shadow: 0 12px 36px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .cost-stack-card.agency-side {
        border-top: 4px solid var(--color-error);
      }

      .cost-stack-card.nobo-side {
        border-top: 4px solid #0070f3;
        background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
        box-shadow: 0 20px 50px rgba(0, 112, 243, 0.08);
      }

      .role-list {
        list-style: none;
        padding: 0;
        margin: var(--spacing-lg) 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .role-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        background: var(--color-canvas-soft);
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-md);
        font-size: 13px;
      }

      .role-item .agency-fee {
        font-family: 'Geist Mono', monospace;
        font-weight: 600;
        color: var(--color-error);
        white-space: nowrap;
      }

      .role-item .nobo-fee {
        font-family: 'Geist Mono', monospace;
        font-weight: 600;
        color: #10b981;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
      }

      .grand-total-banner {
        padding: 16px 20px;
        border-radius: var(--rounded-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: var(--spacing-lg);
      }

      .grand-total-agency {
        background: #fff5f5;
        border: 1px solid rgba(238, 0, 0, 0.2);
      }

      .grand-total-nobo {
        background: #f0f7ff;
        border: 1px solid rgba(0, 112, 243, 0.25);
      }

      /* Interactive Filter Tabs for Comparison Table */
      .filter-tabs-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin: var(--spacing-2xl) auto var(--spacing-xl);
        max-width: 900px;
      }

      .filter-tab {
        background: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-pill);
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 500;
        color: var(--color-body);
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .filter-tab:hover {
        border-color: var(--color-hairline-strong);
        color: var(--color-ink);
      }

      .filter-tab.active {
        background: var(--color-ink);
        border-color: var(--color-ink);
        color: #ffffff;
      }

      /* Mobile Scroll Hint */
      .table-scroll-hint {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin: 0 auto 14px;
        padding: 6px 14px;
        background: rgba(0, 112, 243, 0.08);
        border: 1px solid rgba(0, 112, 243, 0.2);
        border-radius: var(--rounded-pill);
        font-size: 12px;
        font-weight: 600;
        color: #0070f3;
        width: fit-content;
      }

      /* Detailed Table Styles */
      .table-responsive {
        max-width: 1140px;
        margin: 0 auto;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: var(--rounded-xl);
        box-shadow: 0 16px 40px rgba(0,0,0,0.03);
        border: 1px solid var(--color-hairline);
        background: #ffffff;
      }

      .table-container {
        width: 100%;
        min-width: 720px;
      }

      .comp-table {
        width: 100%;
        min-width: 720px;
        border-collapse: collapse;
        text-align: left;
      }

      .comp-table th {
        background: #fafafa;
        padding: 16px 20px;
        font-size: 12px;
        font-family: 'Geist Mono', monospace;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-mute);
        border-bottom: 1px solid var(--color-hairline);
      }

      .comp-table td {
        padding: 18px 20px;
        font-size: 13px;
        border-bottom: 1px solid var(--color-hairline);
        vertical-align: top;
      }

      .comp-table tr:last-child td {
        border-bottom: none;
      }

      .comp-table tr:hover td {
        background-color: #fafbfc;
      }

      .feature-col {
        width: 34%;
        min-width: 220px;
      }

      .agency-col {
        width: 33%;
        min-width: 240px;
        background-color: rgba(254, 242, 242, 0.35);
      }

      .nobogent-col {
        width: 33%;
        min-width: 240px;
        background-color: rgba(240, 247, 255, 0.45);
      }

      .feature-title {
        font-weight: 600;
        font-size: 14px;
        color: var(--color-ink);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .feature-sub {
        font-size: 12px;
        color: var(--color-mute);
        line-height: 1.5;
      }

      .category-pill {
        display: inline-block;
        font-size: 10px;
        font-family: 'Geist Mono', monospace;
        padding: 2px 6px;
        border-radius: 4px;
        background: #f0f0f0;
        color: #555;
        margin-top: 4px;
      }

      .cost-tag-agency {
        display: inline-block;
        font-family: 'Geist Mono', monospace;
        font-weight: 700;
        font-size: 12px;
        color: var(--color-error);
        background: #fee2e2;
        padding: 3px 8px;
        border-radius: 4px;
        margin-bottom: 6px;
      }

      .cost-tag-nobo {
        display: inline-block;
        font-family: 'Geist Mono', monospace;
        font-weight: 700;
        font-size: 12px;
        color: #047857;
        background: #d1fae5;
        padding: 3px 8px;
        border-radius: 4px;
        margin-bottom: 6px;
      }

      /* ROI Calculator */
      .calc-card {
        max-width: 980px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-xl);
        padding: var(--spacing-3xl);
        box-shadow: 0 20px 60px rgba(0,0,0,0.04);
      }

      .calc-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: var(--spacing-3xl);
        align-items: center;
      }

      .slider-control {
        margin-top: 12px;
        width: 100%;
        accent-color: #0070f3;
        height: 6px;
        cursor: pointer;
      }

      .calc-result-box {
        background: linear-gradient(135deg, #171717 0%, #262626 100%);
        color: #ffffff;
        border-radius: var(--rounded-lg);
        padding: var(--spacing-2xl);
        text-align: center;
        box-shadow: 0 16px 36px rgba(0,0,0,0.25);
      }

      /* Pricing Plan Cards */
      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-xl);
        max-width: 1140px;
        margin: var(--spacing-3xl) auto 0;
        text-align: left;
      }

      .plan-card {
        background: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-xl);
        padding: var(--spacing-2xl);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .plan-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.06);
        border-color: var(--color-hairline-strong);
      }

      .plan-card.popular {
        border: 2px solid #0070f3;
        box-shadow: 0 20px 50px rgba(0, 112, 243, 0.12);
        background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
      }

      .popular-ribbon {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(90deg, #0070f3, #7928ca);
        color: #ffffff;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: var(--rounded-pill);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(0, 112, 243, 0.3);
        white-space: nowrap;
      }

      .plan-price-num {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 40px;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--color-ink);
        line-height: 1;
        margin: var(--spacing-md) 0 var(--spacing-xs);
        word-break: break-word;
      }

      .plan-feature-list {
        list-style: none;
        padding: 0;
        margin: var(--spacing-xl) 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 13px;
        color: var(--color-body);
      }

      .plan-feature-list li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        line-height: 1.4;
      }

      .check-icon {
        color: #10b981;
        font-weight: bold;
        flex-shrink: 0;
      }

      /* 1-Deal Math Grid */
      .roi-math-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-2xl);
        text-align: center;
      }

      /* FAQ Accordion */
      .faq-item {
        background: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: var(--rounded-lg);
        margin-bottom: 12px;
        overflow: hidden;
        transition: border-color 0.2s ease;
      }

      .faq-item:hover {
        border-color: var(--color-hairline-strong);
      }

      .faq-header {
        padding: 20px 24px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
        gap: 12px;
      }

      .faq-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-ink);
        line-height: 1.4;
      }

      .faq-toggle-icon {
        font-size: 18px;
        color: var(--color-mute);
        transition: transform 0.2s ease;
        flex-shrink: 0;
      }

      .faq-body {
        padding: 0 24px 20px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--color-body);
        display: none;
      }

      .faq-item.open .faq-body {
        display: block;
      }

      .faq-item.open .faq-toggle-icon {
        transform: rotate(45deg);
      }

      .footer-logo-img {
        height: 48px;
        width: auto;
        max-width: 170px;
        object-fit: contain;
      }

      /* ======================================================== */
      /* RESPONSIVE MEDIA QUERIES                                 */
      /* ======================================================== */

      /* Medium Screens / Tablets (<= 992px) */
      @media (max-width: 992px) {
        .pricing-hero h1 {
          font-size: clamp(2rem, 5vw, 3.25rem);
        }
        .stats-strip {
          grid-template-columns: repeat(2, 1fr);
          padding: 20px 18px;
          gap: 16px;
        }
        .stat-card:nth-child(2) {
          border-right: none;
        }
        .stat-card:nth-child(3) {
          border-right: 1px solid var(--color-hairline);
        }
        .stat-num {
          font-size: 28px;
        }
        .calc-grid {
          grid-template-columns: 1fr;
          gap: var(--spacing-xl);
        }
        .pricing-grid {
          grid-template-columns: 1fr;
          max-width: 520px;
          margin-left: auto;
          margin-right: auto;
        }
      }

      /* Tablet & Smaller Devices (<= 840px) */
      @media (max-width: 840px) {
        .desktop-nav {
          display: none;
        }
        .mobile-menu-btn {
          display: flex;
        }
        .split-compare-grid {
          grid-template-columns: 1fr;
          gap: var(--spacing-xl);
          margin-top: var(--spacing-xl);
        }
        .table-scroll-hint {
          display: inline-flex;
        }
        .filter-tabs-wrapper {
          justify-content: flex-start;
          overflow-x: auto;
          flex-wrap: nowrap;
          -webkit-overflow-scrolling: touch;
          padding: 6px 4px 14px;
          margin: var(--spacing-lg) 0 var(--spacing-md);
          scrollbar-width: none;
        }
        .filter-tabs-wrapper::-webkit-scrollbar {
          display: none;
        }
        .filter-tab {
          white-space: nowrap;
          flex-shrink: 0;
          padding: 7px 14px;
          font-size: 12px;
        }
        .roi-math-grid {
          grid-template-columns: 1fr;
          gap: var(--spacing-md);
          margin-bottom: var(--spacing-xl);
        }
      }

      /* Mobile Devices (<= 640px) */
      @media (max-width: 640px) {
        .container {
          padding: 0 16px !important;
        }
        main > section {
          padding: clamp(40px, 8vw, 64px) 0 !important;
        }
        .pricing-hero {
          padding: 36px 0 20px;
        }
        .pricing-hero h1 {
          font-size: clamp(1.75rem, 6.5vw, 2.35rem);
          line-height: 1.15;
          margin-bottom: 12px;
        }
        .pricing-hero p {
          font-size: 15px !important;
          line-height: 1.55 !important;
          margin-bottom: 20px !important;
        }
        .hero-btn-group {
          flex-direction: column;
          width: 100%;
          max-width: 340px;
          margin: 0 auto;
          gap: 10px !important;
        }
        .hero-btn-group .btn {
          width: 100%;
          padding: 12px 18px !important;
          font-size: 14px !important;
        }

        .stats-strip {
          grid-template-columns: 1fr;
          padding: 18px 16px;
          gap: 14px;
          margin-top: var(--spacing-xl);
        }
        .stat-card {
          padding: 10px 0;
          border-right: none;
          border-bottom: 1px solid var(--color-hairline);
        }
        .stat-card:last-child {
          border-bottom: none;
        }
        .stat-num {
          font-size: 26px;
        }

        .cost-stack-card {
          padding: 20px 16px;
          border-radius: var(--rounded-lg);
        }
        .cost-stack-card-header {
          flex-direction: column;
          align-items: flex-start !important;
          gap: 8px;
        }
        .role-item {
          padding: 10px 12px;
          gap: 10px;
          align-items: flex-start;
        }
        .role-item strong {
          font-size: 13px;
          line-height: 1.35;
          display: block;
        }
        .role-item .agency-fee,
        .role-item .nobo-fee {
          font-size: 12px;
          flex-shrink: 0;
          margin-top: 2px;
        }
        .grand-total-banner {
          flex-direction: column !important;
          align-items: flex-start !important;
          gap: 12px !important;
          padding: 14px 16px !important;
        }
        .grand-total-banner > div:last-child {
          text-align: left !important;
          border-top: 1px solid rgba(0, 0, 0, 0.08);
          padding-top: 10px;
