<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nobogent - Real Estate AI</title>
    <meta name="description" content="Nobogent - World's First AI Sales & Marketing Department For Real Estate" />
    <link rel="icon" type="image/png" href="/logo-transparent.png" />
    <!-- Professional, modern geometric font pairing -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f8f9fa;
            --primary: #1a73e8;
            --primary-light: #e8f0fe;
            --secondary: #ea4335;
            --secondary-light: #fce8e6;
            --success: #34a853;
            --success-light: #e6f4ea;
            --warning: #fbbc04;
            --warning-light: #fef7e0;
            --dark: #1f2937;
            --gray: #4b5563;
            --card-bg: rgba(255, 255, 255, 0.85);
            --radius-sm: 24px;
            --radius-lg: 40px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-color);
            color: var(--dark);
            overflow: hidden; /* Main window shouldn't scroll, individual slides will */
            height: 100vh;
            width: 100vw;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        /* CSS Art / Background Blobs */
        .background-art {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            overflow: hidden;
            background: #f8f9fa;
        }

        .blob {
            position: absolute;
            filter: blur(80px);
            opacity: 0.6;
            animation: float 20s infinite ease-in-out alternate;
        }

        .blob-1 {
            top: -10%; left: -10%;
            width: 50vw; height: 50vw;
            background: #a8c7fa;
            border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
        }

        .blob-2 {
            bottom: -20%; right: -10%;
            width: 60vw; height: 60vw;
            background: #fdd663;
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            animation-delay: -5s;
        }

        .blob-3 {
            top: 40%; left: 60%;
            width: 40vw; height: 40vw;
            background: #f28b82;
            border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
            animation-delay: -10s;
        }

        @keyframes float {
            0% { transform: translate(0, 0) rotate(0deg) scale(1); }
            100% { transform: translate(100px, 50px) rotate(20deg) scale(1.1); }
        }

        /* Presentation Container */
        .presentation {
            position: relative;
            width: 100%;
            height: 100%;
        }

        /* Slides Layout Engine - Built for Scrollability */
        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow-y: auto; /* Allows scrolling on mobile */
            overflow-x: hidden;
            opacity: 0;
            visibility: hidden;
            transform: scale(0.95) translateY(30px);
            transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }

        /* Wrapper centers content horizontally & vertically, while keeping the 120px padding at bottom for buttons */
        .slide-wrapper {
            min-height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 5% 120px 5%; /* 120px bottom padding guarantees the UI controls never overlap the content */
        }

        .slide.active {
            opacity: 1;
            visibility: visible;
            transform: scale(1) translateY(0);
        }

        .slide.exit-left {
            transform: scale(0.95) translateX(-100px);
            opacity: 0;
        }

        .slide.exit-right {
            transform: scale(0.95) translateX(100px);
            opacity: 0;
        }

        /* Card Design */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: var(--radius-lg);
            padding: 3.5rem;
            max-width: 1050px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            text-align: center;
            border: 1px solid rgba(255,255,255,0.6);
        }

        /* Typography */
        h1, h2, h3, .price-tag {
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -0.02em;
        }

        h1 {
            font-size: 3.8rem;
            font-weight: 800;
            margin-bottom: 1rem;
            color: var(--dark);
            line-height: 1.15;
        }

        h2 {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--dark);
        }

        h3 {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        p {
            font-size: 1.15rem;
            color: var(--gray);
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        /* Highlight Text */
        .highlight-blue { color: var(--primary); }
        .highlight-red { color: var(--secondary); }
        .highlight-green { color: var(--success); }
        .highlight-yellow { color: var(--warning); }

        /* Bubbly Grids */
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .bubbly-box {
            padding: 2.2rem;
            border-radius: var(--radius-sm);
            text-align: left;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .bubbly-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

        .bg-red { background: var(--secondary-light); border: 2px solid #fad2cf; }
        .bg-green { background: var(--success-light); border: 2px solid #c4eed0; }
        .bg-blue { background: var(--primary-light); border: 2px solid #aecbfa; }
        .bg-yellow { background: var(--warning-light); border: 2px solid #fde293; }

        /* Tags / Pills */
        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            margin-top: 2rem;
        }

        .tag {
            background: #fff;
            color: var(--primary);
            padding: 0.7rem 1.4rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.05rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            border: 1px solid var(--primary-light);
        }

        /* Custom Elements */
        .logo {
            height: 100px;
            max-width: 100%;
            object-fit: contain;
            margin-bottom: 2rem;
        }

        .price-tag {
            font-size: 4rem;
            font-weight: 800;
            color: var(--primary);
            background: var(--primary-light);
            display: inline-block;
            padding: 1rem 3rem;
            border-radius: 100px;
            margin: 1rem 0;
            letter-spacing: -0.04em;
        }

        .strikethrough {
            text-decoration: line-through;
            color: var(--secondary);
            font-size: 2rem;
            font-weight: 700;
            opacity: 0.7;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Navigation Controls */
        .controls {
            position: fixed;
            bottom: 25px; /* Safely tucked at the bottom */
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            background: rgba(255, 255, 255, 0.95);
            padding: 12px 24px;
            border-radius: 100px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            backdrop-filter: blur(15px);
            z-index: 100;
            border: 1px solid rgba(0,0,0,0.1);
        }

        .btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn:hover {
            background: #1557b0;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(26, 115, 232, 0.3);
        }

        .btn:disabled {
            background: #e5e7eb;
            color: #9ca3af;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .progress-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0 15px;
        }

        .dot {
            width: 8px;
            height: 8px;
            background: #d1d5db;
            border-radius: 50%;
            transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .dot.active {
            background: var(--primary);
            width: 24px;
            border-radius: 10px;
        }

        /* Gradient background for emphasis slide */
        .gradient-card {
            background: linear-gradient(135deg, var(--primary), #4285f4);
            border: none;
            color: white;
            box-shadow: 0 25px 50px rgba(26, 115, 232, 0.2);
        }

        .gradient-card h2, .gradient-card h3 { color: white; }
        .gradient-card p { color: rgba(255, 255, 255, 0.9); }

        /* Comparison Table Styles */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            margin-top: 1rem;
            -webkit-overflow-scrolling: touch;
        }

        .comp-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 10px;
            text-align: left;
        }

        .comp-table th {
            padding: 14px 18px;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--dark);
            border-bottom: 2px solid rgba(0,0,0,0.08);
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .comp-table td {
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.9);
            font-size: 1.05rem;
            vertical-align: middle;
        }

        .comp-table tr td:first-child {
            border-top-left-radius: 16px;
            border-bottom-left-radius: 16px;
        }

        .comp-table tr td:last-child {
            border-top-right-radius: 16px;
            border-bottom-right-radius: 16px;
        }

        .role-title {
            font-weight: 700;
            color: var(--dark);
            font-size: 1.1rem;
        }

        .role-desc {
            font-size: 0.9rem;
            color: var(--gray);
            margin-top: 2px;
        }

        .badge-cost {
            display: inline-block;
            background: var(--secondary-light);
            color: var(--secondary);
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.95rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .badge-included {
            display: inline-block;
            background: var(--success-light);
            color: var(--success);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.95rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .comp-table tr.total-row td {
            background: #e8f0fe;
            border: 2px solid #aecbfa;
        }

        /* Annual Packages Pricing Grid */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-top: 1.5rem;
            text-align: left;
        }

        .plan-card {
            background: white;
            border-radius: var(--radius-sm);
            padding: 2.2rem;
            border: 2px solid rgba(0,0,0,0.06);
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 10px 25px rgba(0,0,0,0.03);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .plan-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        }

        .plan-popular {
            border-color: var(--primary);
            box-shadow: 0 15px 35px rgba(26, 115, 232, 0.15);
            background: #fafcff;
        }

        .popular-badge {
            position: absolute;
            top: -14px;
            right: 24px;
            background: var(--primary);
            color: white;
            font-size: 0.75rem;
            font-weight: 800;
            padding: 4px 14px;
            border-radius: 50px;
            letter-spacing: 0.05em;
        }

        .plan-header h3 {
            font-size: 1.8rem;
            color: var(--dark);
            margin-bottom: 0.3rem;
        }

        .plan-tag {
            display: inline-block;
            background: #f1f3f4;
            color: var(--gray);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 12px;
            margin-bottom: 1rem;
        }

        .plan-price {
            font-size: 2.4rem;
            font-weight: 800;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--dark);
            margin-bottom: 1.2rem;
        }

        .gst-text {
            font-size: 1rem;
            font-weight: 600;
            color: var(--gray);
        }

        .plan-features {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
            font-size: 1.05rem;
            color: var(--dark);
            margin-top: 0.5rem;
        }

        .plan-features li {
            line-height: 1.5;
        }

        .feature-disabled {
            opacity: 0.6;
            color: var(--gray);
        }

        /* Guarantee & ROI Styles */
        .guarantee-badge {
            background: linear-gradient(135deg, #137333, #34a853);
            color: white;
            padding: 1rem 2.2rem;
            border-radius: 100px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 1.25rem;
            font-weight: 800;
            box-shadow: 0 10px 25px rgba(52, 168, 83, 0.25);
            margin-bottom: 1.2rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .roi-stat {
            font-size: 2.2rem;
            font-weight: 800;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .roi-math-box {
            background: white;
            border-radius: var(--radius-sm);
            padding: 1.8rem;
            border: 2px solid #c4eed0;
            margin-top: 1.5rem;
            text-align: left;
            box-shadow: 0 10px 30px rgba(52, 168, 83, 0.06);
        }

        .tc-note {
            font-size: 0.85rem;
            color: var(--gray);
            margin-top: 1rem;
            font-style: italic;
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            h1 { font-size: 2.4rem; }
            h2 { font-size: 2rem; }
            .card { padding: 2rem 1.5rem; border-radius: var(--radius-sm); }
            .price-tag { font-size: 2.8rem; padding: 0.8rem 2rem; }
            .logo { height: 75px; } /* Slightly scaled down logo for mobile, but still large */
            .blob { filter: blur(50px); }
            .grid-3, .grid-2 { grid-template-columns: 1fr; }
            .controls { bottom: 15px; width: 90%; justify-content: space-between; padding: 10px 15px; }
            .progress-indicator { display: none; }
            .slide-wrapper { padding: 1.5rem 5% 100px 5%; } /* Keeps padding on mobile so buttons don't block content */
            .pricing-grid { grid-template-columns: 1fr; }
            .comp-table th, .comp-table td { padding: 10px 12px; font-size: 0.85rem; }
            .role-title { font-size: 0.95rem; }
            .role-desc { font-size: 0.8rem; }
            .badge-cost, .badge-included { font-size: 0.8rem; padding: 4px 8px; }
            .plan-price { font-size: 2rem; }
        }
    </style>
</head>
<body>

    <!-- CSS Art Background -->
    <div class="background-art">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <div class="presentation" id="presentation">
        
        <!-- Slide 1: Intro -->
        <div class="slide active">
            <div class="slide-wrapper">
                <div class="card">
                    <img src="/logo-transparent.png" alt="Nobogent Logo" class="logo">
                    <h1>World's First <br> <span class="highlight-blue">AI Sales & Marketing Department</span></h1>
                    <h2 style="color: var(--gray); margin-top: 10px; font-weight: 500;">For Real Estate</h2>
                    <p style="font-size: 1.4rem; max-width: 650px; margin: 0 auto;">
                        We handle everything from lead generation to appointment booking, entirely powered by intelligent AI.
                    </p>
                </div>
            </div>
        </div>

        <!-- Slide 2: The Pain -->
        <div class="slide">
            <div class="slide-wrapper">
                <div class="card">
                    <h2>The Real Estate <span class="highlight-red">Pain Points</span></h2>
                    <p style="font-size: 1.3rem;">Converting real estate leads is exhausting. Here is why most fail:</p>
                    <div class="grid-3">
                        <div class="bubbly-box bg-red">
                            <h3 class="highlight-red">🗑️ Low Quality Leads</h3>
                            <p>Marketing agencies send you junk traffic that never answers the phone or actually qualifies for the property.</p>
                        </div>
                        <div class="bubbly-box bg-red">
                            <h3 class="highlight-red">⏳ No Regular Follow-ups</h3>
                            <p>Real estate leads take months to convert. Human teams burn out, get disorganized, and stop following up too early.</p>
                        </div>
                        <div class="bubbly-box bg-red">
                            <h3 class="highlight-red">📉 Low Trust</h3>
                            <p>Without consistent professional touchpoints and branded retargeting, prospects simply forget you and go to competitors.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slide 3: The "What If" -->
        <div class="slide">
            <div class="slide-wrapper">
                <div class="card gradient-card">
                    <h2 style="font-size: 3.2rem; margin-bottom: 1rem;">What if things were <span class="highlight-yellow">different?</span></h2>
                    <p style="font-size: 1.6rem; max-width: 800px; margin: 0 auto 3rem auto; line-height: 1.6;">
                        Imagine a system where you <strong>never</strong> have to hire expensive marketing agencies, manage chaotic teams of telecallers, or stress about missed follow-ups.
                    </p>
                    <div class="bubbly-box" style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); display: inline-block; text-align: center;">
                        <h3 style="font-size: 1.8rem; margin-bottom: 10px;">From Lead Generation to Site Visit...</h3>
                        <p style="color: var(--warning-light); font-size: 1.3rem; margin: 0; font-weight: 500;">Every query, follow-up, and booking is handled autonomously by one intelligent system.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slide 4: The Solution -->
        <div class="slide">
            <div class="slide-wrapper">
                <div class="card">
                    <h2>How Nobogent <span class="highlight-green">Solves This</span></h2>
                    <p style="font-size: 1.3rem;">A completely automated ecosystem that works 24/7/365.</p>
                    <div class="grid-3">
                        <div class="bubbly-box bg-green">
                            <h3 class="highlight-green">🎯 Generate Leads</h3>
                            <p>High-intent lead generation campaigns designed specifically for high-ticket real estate conversions.</p>
                        </div>
                        <div class="bubbly-box bg-green">
                            <h3 class="highlight-green">🤖 AI Bot Follow-ups</h3>
                            <p>Instant AI Calling & WhatsApp bot qualification. We follow up immediately and persistently.</p>
                        </div>
                        <div class="bubbly-box bg-green">
                            <h3 class="highlight-green">🔄 Retargeting</h3>
                            <p>Automated omnichannel retargeting campaigns to build massive brand trust over the long buying cycle.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slide 5: AI Advantage -->
        <div class="slide">
            <div class="slide-wrapper">
                <div class="card" style="background: var(--primary-light); border-color: #aecbfa;">
                    <h2>Everything Handled by <span class="highlight-blue">AI</span></h2>
                    <p style="color: var(--dark); font-size: 1.3rem; font-weight: 500;">Sit back and watch your site visits and calendar fill up.</p>
                    
                    <div class="grid-2">
                        <div class="bubbly-box" style="background: white; border: 1px solid rgba(0,0,0,0.05);">
                            <h3 style="color: var(--dark);">✨ The AI Workforce</h3>
                            <ul style="list-style: none; text-align: left; font-size: 1.15rem; line-height: 1.9; color: var(--gray); margin-top: 1rem;">
                                <li>✅ Instant Lead Qualification</li>
                                <li>✅ Relentless, Timely Follow-ups</li>
                                <li>✅ Natural Query Resolutions</li>
                                <li>✅ Automated Appointment Bookings</li>
                            </ul>
                        </div>
                        <div class="bubbly-box" style="background: white; border: 1px solid rgba(0,0,0,0.05);">
                            <h3 style="color: var(--dark);">📱 Stay in the Loop</h3>
                            <ul style="list-style: none; text-align: left; font-size: 1.15rem; line-height: 1.9; color: var(--gray); margin-top: 1rem;">
                                <li>🔔 Instant WhatsApp & Email Notifications</li>
                                <li>📊 Full natural-language reporting</li>
                                <li>💬 Chat directly with Nobogent Bot for updates</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slide 6: Cost Savings Comparison -->
        <div class="slide">
            <div class="slide-wrapper">
                <div class="card" style="max-width: 1100px;">
                    <h2>Traditional Team Costs vs <span class="highlight-blue">Nobogent</span></h2>
                    <p style="font-size: 1.25rem;">See how much money Nobogent saves your real estate business every single month</p>
                    
                    <div class="table-responsive">
                        <table class="comp-table">
                            <thead>
                                <tr>
                                    <th>Role / Resource</th>
                                    <th>Traditional Cost (Monthly)</th>
                                    <th>Nobogent AI System</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="role-title">📢 Ads Manager</div>
                                        <div class="role-desc">Managing ads & lead gen campaigns</div>
                                    </td>
                                    <td><span class="badge-cost">₹10,000 – ₹15,000 / mo</span></td>
                                    <td><span class="badge-included">✅ Included</span></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="role-title">🎨 Graphics & Video Creator</div>
                                        <div class="role-desc">Creating banners, graphics & promotional videos</div>
                                    </td>
                                    <td><span class="badge-cost">₹10,000 – ₹15,000 / mo</span></td>
                                    <td><span class="badge-included">✅ Included</span></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="role-title">📊 Real Estate CRM</div>
