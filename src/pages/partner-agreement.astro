          <h2 class="doc-title">Sales Partner Responsibilities & CRM Policy</h2>
          
          <div class="policy-list">
            <div class="policy-card">
              <h4><span class="policy-num">1</span> Lead Management</h4>
              <ul>
                <li>All assigned leads must be recorded and updated in the Nobogent CRM system.</li>
                <li>Each lead must have an accurate current status, detailed conversation notes, and a scheduled next follow-up date.</li>
                <li>Leads must be contacted within the response time communicated during onboarding training.</li>
                <li>Duplicate records and existing customer relationships must be reported immediately to the reporting manager.</li>
              </ul>
            </div>

            <div class="policy-card">
              <h4><span class="policy-num">2</span> Calling & Communication</h4>
              <ul>
                <li>Use company-approved calling and communication systems for all business-related prospecting.</li>
                <li>Log all call outcomes and follow-up action items inside Nobogent.</li>
                <li>Do not make misleading claims regarding results, system features, pricing, or unauthorized guarantees.</li>
                <li>Follow all applicable calling, messaging, consent, and opt-out regulations (TRAI/DND guidelines).</li>
                <li>Access call recordings and client data only for authorized business purposes.</li>
              </ul>
            </div>

            <div class="policy-card">
              <h4><span class="policy-num">3</span> Customer Ownership & Confidentiality</h4>
              <ul>
                <li>All customer and prospect records created or assigned through the program remain the exclusive proprietary property of NOBOGENT AI SOLUTIONS LLP.</li>
                <li>Do not export, copy, sell, disclose, or use customer data for personal or unauthorized purposes.</li>
                <li>Do not redirect company prospects or clients to any competing service or third party.</li>
                <li>Do not share platform credentials or permit unauthorized third-party access.</li>
                <li>Report any suspected data loss, security vulnerability, or credential misuse immediately.</li>
              </ul>
            </div>

            <div class="policy-card">
              <h4><span class="policy-num">4</span> Professional Conduct</h4>
              <ul>
                <li>Treat all prospects, clients, and partners respectfully and ethically at all times.</li>
                <li>Follow strictly approved pricing tiers and discount policies without unauthorized side-deals.</li>
                <li>Escalate technical, billing, and contractual questions promptly to authorized personnel.</li>
                <li>Do not promise custom development features or delivery commitments without written management approval.</li>
              </ul>
            </div>

            <div class="policy-card">
              <h4><span class="policy-num">5</span> Access & Offboarding</h4>
              <ul>
                <li>Upon the termination or conclusion of the engagement, the partner must immediately cease using company systems.</li>
                <li>Return or permanently delete all company information as directed by Nobogent.</li>
                <li>Fully cooperate with the orderly transfer of active prospects and customer accounts to designated team members.</li>
                <li>Continuing non-disclosure and confidentiality obligations will remain in full effect under applicable law.</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- DOCUMENT 4: FIRST 30 DAYS ONBOARDING PLAN -->
        <section id="doc4-onboarding" class="doc-card">
          <span class="doc-pill">DOCUMENT 4</span>
          <h2 class="doc-title">First 30 Days: Onboarding Plan</h2>
          <p class="doc-body-p">
            A structured four-week roadmap designed to fast-track your product mastery, lead qualification skills, and initial closed customer commissions.
          </p>

          <div class="timeline-container">
            <div class="timeline-card">
              <div class="timeline-badge">
                <span>Week</span>
                <span>01</span>
              </div>
              <div class="timeline-content">
                <h4>Learn the Product & Positioning</h4>
                <ul>
                  <li>Complete comprehensive Nobogent platform walkthrough.</li>
                  <li>Master target real estate audience profiles and core value propositions.</li>
                  <li>Learn the CRM, in-app calling, WhatsApp workflow, and lead status pipeline.</li>
                  <li>Practice sales pitch scripts and core objection-handling techniques.</li>
                  <li>Complete mock sales call and live product demonstration with your manager.</li>
                </ul>
              </div>
            </div>

            <div class="timeline-card">
              <div class="timeline-badge">
                <span>Week</span>
                <span>02</span>
              </div>
              <div class="timeline-content">
                <h4>Begin Prospecting & Active Outreach</h4>
                <ul>
                  <li>Receive initial cohort of qualified sales leads.</li>
                  <li>Commence outbound prospecting and discovery calls.</li>
                  <li>Record all activities, status notes, and next follow-ups in Nobogent CRM.</li>
                  <li>Attend weekly 1-on-1 sales coaching and review call recordings for feedback.</li>
                  <li>Refine discovery questions and value articulation.</li>
                </ul>
              </div>
            </div>

            <div class="timeline-card">
              <div class="timeline-badge">
                <span>Week</span>
                <span>03</span>
              </div>
              <div class="timeline-content">
                <h4>Improve Conversions & Demos</h4>
                <ul>
                  <li>Conduct guided live product demonstrations with warm prospects.</li>
                  <li>Follow up diligently with pipeline opportunities and send commercial proposals.</li>
                  <li>Identify recurring client objections and apply tailored solutions.</li>
                  <li>Review demo-to-close conversion rates with your manager.</li>
                </ul>
              </div>
            </div>

            <div class="timeline-card">
              <div class="timeline-badge">
                <span>Week</span>
                <span>04</span>
              </div>
              <div class="timeline-content">
                <h4>Performance Review & Scale</h4>
                <ul>
                  <li>Review calls attempted, connects, and qualified prospect benchmarks.</li>
                  <li>Review meetings booked, presentations completed, and proposals issued.</li>
                  <li>Analyze new paying customers closed and gross revenue collected.</li>
                  <li>Assist with customer onboarding and early retention kickoff.</li>
                  <li>Agree upon recurring monthly activity targets and revenue goals.</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- DOCUMENT 5: PARTNER ACKNOWLEDGMENT & AGREEMENT FORM -->
        <section id="doc5-acknowledgment" class="doc-card" style="border-left: 4px solid #2563eb;">
          <span class="doc-pill" style="background: #eff6ff; color: #1d4ed8;">DOCUMENT 5</span>
          <h2 class="doc-title">Partner Acknowledgment</h2>
          <p class="doc-body-p">
            By completing and submitting the form below, you formally acknowledge and confirm your acceptance of the terms governing the Nobogent Sales Partner Program.
          </p>

          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px 20px; font-size: 14px; line-height: 1.6; color: #334155;">
            <strong>I acknowledge that:</strong>
            <ul style="margin-top: 8px; padding-left: 20px;">
              <li>I have received and reviewed the complete Sales Partner Onboarding Pack.</li>
              <li>I understand the commission-only nature of the opportunity and that no fixed salary is promised under this proposal.</li>
              <li>I understand that commission rates, eligibility, and payment timing are governed by the signed commission policy.</li>
              <li>I will use the company's approved CRM and communication systems for assigned business activities.</li>
              <li>I will protect confidential information and handle customer data only for authorized purposes.</li>
              <li>I understand that the formal Sales Partner Agreement governs the engagement and takes precedence over this onboarding pack where specified.</li>
            </ul>
          </div>
        </section>

        <!-- DIGITAL EXECUTION & SUBMISSION FORM -->
        <section id="partner-form" class="form-section">
          <div style="margin-bottom: 24px; text-align: left;">
            <div style="display: inline-block; padding: 4px 10px; background: #eff6ff; color: #2563eb; font-size: 11px; font-weight: 700; border-radius: 6px; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 8px;">
              Digital Agreement Execution
            </div>
            <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 6px; letter-spacing: -0.02em;">
              Complete Your Partner Agreement Form
            </h2>
            <p style="font-size: 14px; color: #64748b; margin: 0;">
              Please fill in your details, review the acknowledgment checkboxes, and submit. An executed confirmation copy will be emailed directly to your inbox.
            </p>
          </div>

          <!-- SUCCESS CARD OVERLAY (Appears after submission) -->
          <div id="successCard" class="success-modal">
            <div class="success-icon">✓</div>
            <h3 style="font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">
              Partner Agreement Executed!
            </h3>
            <p style="font-size: 15px; color: #475569; max-width: 540px; margin: 0 auto 20px; line-height: 1.6;">
              Congratulations <strong id="successPartnerName">Partner</strong>! Your agreement has been recorded and an official execution copy has been dispatched to <strong id="successPartnerEmail">your email</strong>.
            </p>

            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; max-width: 500px; margin: 0 auto 24px; text-align: left; font-size: 13px;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                <span style="color: #64748b;">Verification ID:</span>
                <span style="font-family: monospace; font-weight: bold; color: #0f172a;" id="successDocId">NBG-PARTNER-CONFIRMED</span>
              </div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                <span style="color: #64748b;">Execution Timestamp:</span>
                <span style="color: #0f172a;" id="successTimestamp">-</span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="color: #64748b;">Next Action:</span>
                <span style="color: #2563eb; font-weight: 600;">Check email & connect with Manager</span>
              </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
              <button onclick="window.print()" class="partner-jump-btn" style="background: #0f172a; border: none; cursor: pointer;">
                <span>🖨️ Print / Save Copy</span>
              </button>
              <a href="/" class="subnav-link" style="padding: 10px 20px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px;">
                Back to Homepage
              </a>
            </div>
          </div>

          <!-- The Active Submission Form -->
          <form id="partnerAgreementForm" novalidate>
            <div class="form-grid">
              
              <!-- Full Name -->
              <div class="form-group">
                <label for="partnerName" class="form-label">Full Name <span class="req">*</span></label>
                <input type="text" id="partnerName" class="form-input" placeholder="e.g. Rahul Sharma" required />
              </div>

              <!-- Email -->
              <div class="form-group">
                <label for="partnerEmail" class="form-label">Email Address (for confirmation) <span class="req">*</span></label>
                <input type="email" id="partnerEmail" class="form-input" placeholder="e.g. rahul@example.com" required />
              </div>

              <!-- Phone -->
              <div class="form-group">
                <label for="partnerPhone" class="form-label">Phone / WhatsApp Number <span class="req">*</span></label>
                <input type="tel" id="partnerPhone" class="form-input" placeholder="e.g. +91 98765 43210" required />
              </div>

              <!-- City / Location -->
              <div class="form-group">
                <label for="partnerCity" class="form-label">City / Territory <span class="req">*</span></label>
                <input type="text" id="partnerCity" class="form-input" placeholder="e.g. Gurugram / Mumbai / Bangalore" required />
              </div>

              <!-- Proposed Start Date -->
              <div class="form-group">
                <label for="startDate" class="form-label">Proposed Start Date <span class="req">*</span></label>
                <input type="date" id="startDate" class="form-input" required />
              </div>

              <!-- Reporting Manager -->
              <div class="form-group">
                <label for="reportingManager" class="form-label">Reporting Manager / Coordinator</label>
                <input type="text" id="reportingManager" class="form-input" value="Nobogent Partnerships Lead" />
              </div>

              <!-- Package / Tier -->
              <div class="form-group">
                <label for="packageName" class="form-label">Assigned Product / Package</label>
                <select id="packageName" class="form-select">
                  <option value="Nobogent AI Real Estate Growth Suite" selected>Nobogent AI Real Estate Growth Suite (Default)</option>
                  <option value="Nobogent AI Voice Calling Engine">Nobogent AI Voice Calling Engine</option>
                  <option value="Nobogent WhatsApp Omnichannel Suite">Nobogent WhatsApp Omnichannel Suite</option>
                  <option value="Nobogent Enterprise Custom Suite">Nobogent Enterprise Custom Suite</option>
                </select>
              </div>

              <!-- Experience -->
              <div class="form-group">
                <label for="salesExperience" class="form-label">Sales / Real Estate Experience</label>
                <select id="salesExperience" class="form-select">
                  <option value="1-3 years">1–3 Years in Sales / Real Estate</option>
                  <option value="3-5 years">3–5 Years in Sales / Tech</option>
                  <option value="5+ years">5+ Years Senior Sales / Brokerage</option>
                  <option value="Independent Consultant">Independent Consultant / Agency Owner</option>
                  <option value="New to Real Estate">Entry Level / High Drive to Learn</option>
                </select>
              </div>

              <!-- Additional Notes -->
              <div class="form-group full-width">
                <label for="partnerNotes" class="form-label">Additional Comments / Note to Coordinator (Optional)</label>
                <textarea id="partnerNotes" class="form-textarea" rows="2" placeholder="Any specific target real estate builders, territories, or queries..."></textarea>
              </div>

            </div>

            <!-- Mandatory Checkbox Clauses -->
            <div class="clauses-container">
              <label class="clause-item">
                <input type="checkbox" id="chkReview" class="clause-checkbox" required checked />
                <span class="clause-text">
                  <strong>Onboarding Pack Acceptance:</strong> I confirm that I have received, reviewed, and agree to the Nobogent Sales Partner Onboarding Pack.
                </span>
              </label>

              <label class="clause-item">
                <input type="checkbox" id="chkCommission" class="clause-checkbox" required checked />
                <span class="clause-text">
                  <strong>Commission-Only Terms:</strong> I understand that this is a performance-based, commission-only opportunity and that no fixed salary is promised.
                </span>
              </label>

              <label class="clause-item">
                <input type="checkbox" id="chkCrm" class="clause-checkbox" required checked />
                <span class="clause-text">
                  <strong>CRM & Lead Handling:</strong> I agree to use Nobogent's approved CRM, log all client interactions, and protect company and customer confidentiality.
                </span>
              </label>

              <label class="clause-item">
                <input type="checkbox" id="chkAgreement" class="clause-checkbox" required checked />
                <span class="clause-text">
                  <strong>Governing Agreement:</strong> I acknowledge that the formal Sales Partner Agreement and written commission policy govern this engagement and take precedence where specified.
                </span>
              </label>
            </div>

            <!-- Error message container -->
            <div id="formErrorMsg" class="form-status-msg error"></div>

            <!-- Submit Button -->
            <button type="submit" id="submitBtn" class="submit-btn">
              <span id="btnText">Accept Terms & Submit Agreement</span>
              <div id="btnSpinner" class="spinner"></div>
            </button>

            <p style="text-align: center; font-size: 12px; color: #64748b; margin-top: 12px;">
              🔒 Encrypted 256-bit submission. A confirmation copy will be emailed to your address immediately.
            </p>
          </form>
        </section>

        <!-- Administrative Note Footer -->
        <div style="background: #f1f5f9; border-radius: 8px; padding: 16px 20px; font-size: 12px; color: #64748b; line-height: 1.5; text-align: center;">
          <strong>Administrative note:</strong> This onboarding pack reflects agreed commercial terms and policy standards. The company will attach the final approved commission schedule to the signed agreement. For inquiries, contact <a href="mailto:info@nobogent.com" style="color: #2563eb; text-decoration: underline;">info@nobogent.com</a>.
        </div>

      </main>

      <!-- Standard Global Footer -->
      <footer style="padding: 40px 0 24px; background-color: #ffffff; font-size: 12px; border-top: 1px solid #e2e8f0; margin-top: auto;">
        <div style="max-width: 960px; margin: 0 auto; padding: 0 20px; display: flex; flex-direction: column; gap: 20px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <Image src={logoTransparent} alt="Nobogent Logo" width={160} style="height: 48px; width: auto; object-fit: contain;" />
            </div>
            <div style="display: flex; gap: 16px; color: #64748b;">
              <a href="/">Home</a>
              <a href="/pricing-india">Pricing</a>
              <a href="/privacy-policy">Privacy Policy</a>
              <a href="/terms-of-service">Terms of Service</a>
            </div>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 16px; text-align: center; color: #94a3b8;">
            © {new Date().getFullYear()} NOBOGENT AI SOLUTIONS LLP. All rights reserved.
          </div>
        </div>
      </footer>

    </div>

    <!-- Client-side Interactive Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        // Form & Elements
        var form = document.getElementById('partnerAgreementForm');
        var submitBtn = document.getElementById('submitBtn');
        var btnText = document.getElementById('btnText');
        var btnSpinner = document.getElementById('btnSpinner');
        var formErrorMsg = document.getElementById('formErrorMsg');
        var successCard = document.getElementById('successCard');

        // Inputs
        var partnerNameInput = document.getElementById('partnerName');
        var partnerEmailInput = document.getElementById('partnerEmail');
        var partnerPhoneInput = document.getElementById('partnerPhone');
        var partnerCityInput = document.getElementById('partnerCity');
        var startDateInput = document.getElementById('startDate');
        var reportingManagerInput = document.getElementById('reportingManager');
        var packageNameSelect = document.getElementById('packageName');
        var salesExperienceSelect = document.getElementById('salesExperience');
        var partnerNotesInput = document.getElementById('partnerNotes');
        var typedSignatureInput = document.getElementById('typedSignature');

        // Checkboxes
        var chkReview = document.getElementById('chkReview');
        var chkCommission = document.getElementById('chkCommission');
        var chkCrm = document.getElementById('chkCrm');
        var chkAgreement = document.getElementById('chkAgreement');

        // Dynamic Text updates
        var metaDisplayPartner = document.getElementById('meta-display-partner');
        var metaDisplayDate = document.getElementById('meta-display-date');
        var offerNamePlaceholder = document.getElementById('offer-name-placeholder');

        // Set default start date to today's date in YYYY-MM-DD
        var today = new Date().toISOString().split('T')[0];
        if (startDateInput) {
          startDateInput.value = today;
          if (metaDisplayDate) metaDisplayDate.textContent = today;
        }

        if (partnerNameInput) {
          partnerNameInput.addEventListener('input', function () {
            var val = partnerNameInput.value.trim();
            if (metaDisplayPartner) metaDisplayPartner.textContent = val || '[Enter Below in Form]';
            if (offerNamePlaceholder) offerNamePlaceholder.textContent = val || 'Sales Partner Candidate';
          });
        }

        if (startDateInput) {
          startDateInput.addEventListener('change', function () {
            if (metaDisplayDate) metaDisplayDate.textContent = startDateInput.value || '[Proposed in Form]';
          });
        }

        // ============================================
        // INTERACTIVE COMMISSION CALCULATOR LOGIC
        // ============================================
        var calcSlider = document.getElementById('calcSlider');
        var calcCustCountDisplay = document.getElementById('calcCustCountDisplay');
        var calcRateDisplay = document.getElementById('calcRateDisplay');
        var calcMonthlyTotalDisplay = document.getElementById('calcMonthlyTotalDisplay');
        var calcAnnualTotalDisplay = document.getElementById('calcAnnualTotalDisplay');
        var calcMilestoneDisplay = document.getElementById('calcMilestoneDisplay');

        function updateCommissionCalculator(count) {
          count = parseInt(count, 10) || 1;
          var rate = 400;
          if (count >= 51) {
            rate = 1000;
          } else if (count >= 41) {
            rate = 900;
          } else if (count >= 31) {
            rate = 800;
          } else if (count >= 21) {
            rate = 700;
          } else if (count >= 11) {
            rate = 600;
          } else if (count >= 6) {
            rate = 500;
          } else {
            rate = 400;
          }

          var monthlyTotal = count * rate;
          var annualTotal = monthlyTotal * 12;

          var milestone = 'Base Tier (Tier 1)';
          if (count >= 50) {
            milestone = '✈ Dubai Achiever (6 mo)';
          } else if (count >= 25) {
            milestone = '✦ Growth Champion (3 mo)';
          } else if (count >= 10) {
            milestone = '↗ Retention Champion (3 mo)';
          }

          if (calcCustCountDisplay) calcCustCountDisplay.textContent = count;
          if (calcRateDisplay) calcRateDisplay.textContent = '₹' + rate.toLocaleString('en-IN') + ' / mo';
          if (calcMonthlyTotalDisplay) calcMonthlyTotalDisplay.textContent = '₹' + monthlyTotal.toLocaleString('en-IN');
          if (calcAnnualTotalDisplay) calcAnnualTotalDisplay.textContent = '₹' + annualTotal.toLocaleString('en-IN');
          if (calcMilestoneDisplay) calcMilestoneDisplay.textContent = milestone;
        }

        if (calcSlider) {
          calcSlider.addEventListener('input', function () {
            updateCommissionCalculator(calcSlider.value);
          });
          updateCommissionCalculator(calcSlider.value || 25);
        }

        // ============================================
        // SUBMISSION HANDLER
        // ============================================
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          formErrorMsg.style.display = 'none';
          formErrorMsg.textContent = '';

          // Validate fields
          var name = partnerNameInput.value.trim();
          var email = partnerEmailInput.value.trim();
          var phone = partnerPhoneInput.value.trim();
          var city = partnerCityInput.value.trim();
          var startDate = startDateInput.value;
          var reportingManager = reportingManagerInput.value.trim();
          var packageName = packageNameSelect.value;
          var experience = salesExperienceSelect.value;
          var notes = partnerNotesInput.value.trim();

          if (!name) {
            showError('Please enter your Full Name.');
            partnerNameInput.focus();
            return;
          }

          var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!email || !emailRegex.test(email)) {
            showError('Please enter a valid email address so we can send your confirmation.');
            partnerEmailInput.focus();
            return;
          }

          if (!phone || phone.replace(/\D/g, '').length < 8) {
            showError('Please provide a valid contact / WhatsApp phone number.');
            partnerPhoneInput.focus();
            return;
          }

          if (!city) {
            showError('Please specify your current City / Operating Territory.');
            partnerCityInput.focus();
            return;
          }

          if (!chkReview.checked || !chkCommission.checked || !chkCrm.checked || !chkAgreement.checked) {
            showError('You must review and check all agreement acknowledgment clauses.');
            return;
          }

          // Lock form and trigger spinner
          submitBtn.disabled = true;
          btnText.textContent = 'Submitting & Dispatching Confirmation...';
          btnSpinner.style.display = 'inline-block';

          var payload = {
            partner_name: name,
            email: email,
            phone: phone,
            city: city,
            start_date: startDate,
            reporting_manager: reportingManager,
            package_name: packageName,
            experience: experience,
            notes: notes,
            agreed_terms: {
              onboarding_pack: chkReview.checked,
              commission_slabs: chkCommission.checked,
              crm_compliance: chkCrm.checked,
              formal_agreement: chkAgreement.checked
            },
            acknowledged_at: new Date().toISOString()
          };

          try {
            var response = await fetch('/api/partner-agreement', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            var result = await response.json();

            if (!response.ok) {
              throw new Error(result.error || 'Failed to submit partnership agreement. Please try again.');
            }

            // Success state
            form.style.display = 'none';
            successCard.style.display = 'block';

            var nameEl = document.getElementById('successPartnerName');
            var emailEl = document.getElementById('successPartnerEmail');
            var timeEl = document.getElementById('successTimestamp');
            var docIdEl = document.getElementById('successDocId');

            if (nameEl) nameEl.textContent = name;
            if (emailEl) emailEl.textContent = email;
            if (timeEl) timeEl.textContent = new Date().toLocaleString();
            if (docIdEl) docIdEl.textContent = 'NBG-AGREE-' + Math.random().toString(36).substring(2, 9).toUpperCase();

            // Smooth scroll to success card
            successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });

          } catch (err) {
            console.error('Submission error:', err);
            showError(err.message || 'Network error occurred. Please try again.');
            submitBtn.disabled = false;
            btnText.textContent = 'Accept Terms & Submit Agreement';
            btnSpinner.style.display = 'none';
          }
        });

        function showError(msg) {
          formErrorMsg.textContent = msg;
          formErrorMsg.style.display = 'block';
          formErrorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    </script>
  </body>
</html>
